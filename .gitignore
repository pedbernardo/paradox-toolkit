# General
node_modules
dist
.DS_Store
coverage
*.cpuprofile
*.local
*.log

# Claude Code local settings
.claude/settings.local.json
.claude/projects/

# proprietary binaries - never commit
*.dat
*.spr

# OTServer community files - large files ignored, small fixtures allowed
*.otb
!*.fixture.otb
*.otbm
!*.fixture.otbm

# Root fixtures: only the manifest, the helper package and public *.fixture.* files are versioned
fixtures/client/
fixtures/maps/*
!fixtures/maps/*.fixture.*
fixtures/items/*
!fixtures/items/*.fixture.*

# Temporary files
tmp/

# Draft files
docs/drafts/

# Benchmark output, regenerated on every run (curated results live in results/perf.md)
packages/*/results/*-latest.md

# Removed packages kept for reference, outside git history
references/
