{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": ["eslint", "typescript", "oxc"],
  "categories": {
    "correctness": "error",
    "suspicious": "warn"
  },
  "rules": {
    "typescript/no-explicit-any": "error",
    "typescript/consistent-type-imports": "error",
    "no-var": "error",
    "prefer-const": "error",
    "eqeqeq": "error",
    "no-console": "warn"
  },
  "env": {
    "builtin": true
  },
  "ignorePatterns": [".claude/**", "node_modules/**", "dist/**"]
}
